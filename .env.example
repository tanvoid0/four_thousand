# Copy to `.env` to make the site boot straight to YOUR life instead of a demo.
# `.env` is gitignored, so your data never gets committed. For a deployed build,
# set the same names as GitHub Actions repository secrets instead.
#
# Resolution order at runtime:  anything saved in the browser  >  these vars  >  random demo

# --- Minimal setup: just a birth date ---
VITE_BIRTHDATE=1995-08-17
VITE_NAME=Sam
VITE_LIFESPAN=80

# Optional: life events as a JSON array.
# kind = "milestone" | "countdown" | "recurring"
VITE_EVENTS=[{"id":"1","title":"First job","date":"2018-07-01","kind":"milestone","color":"#fbbf24","emoji":"💼"},{"id":"2","title":"Birthday","date":"1995-08-17","kind":"recurring","color":"#7c6cff","emoji":"🎂"}]

# --- OR, instead of the fields above, paste a full JSON export from the app ---
# (the "Export JSON" button in ⚙ My life gives you exactly this). If set, it wins.
# VITE_PROFILE={"birthDate":"1995-08-17","name":"Sam","lifespanYears":80,"events":[]}
